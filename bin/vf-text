#!/bin/sh
# vf-text [MESSAGE]: text the phone now (it shows in Baresip's chat), over the line's D-Bus control.
# With no MESSAGE it reads the text from stdin, which keeps it out of the process list:
#   echo "on my way" | vf-text
# (On a call Omarchy uses its text_phone tool, which never puts the text on a command line.)
P=$(cd "$(dirname "$0")/.." && pwd)
exec "$P/.venv/bin/python" -I "$P/foremand/linebus.py" text "$@"
