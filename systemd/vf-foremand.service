[Unit]
Description=Voice foreman call handler (Omarchy on the phone)
# After the session target too, like the line and speech: without it systemd sees an ordering
# cycle at login (the target waits for us, we wait for speech, speech waits for the target) and
# drops a job, so foremand wouldn't start on its own.
After=graphical-session.target vf-line.service vf-speech.service
Wants=vf-line.service
# no speech service, no foremand: it never looks for one anywhere else
Requires=vf-speech.service
PartOf=graphical-session.target

[Service]
# logs and state hold transcripts and call recaps: yours alone
UMask=0077
WorkingDirectory={{PROJECT}}
# claude and omarchy-shell must be on PATH; install-services.sh fills it in from yours
Environment=PATH={{PATH}}
EnvironmentFile=-%h/.config/voice-foreman/env
ExecStart={{PROJECT}}/.venv/bin/python foremand/foremand.py
Restart=always
RestartSec=5
# foremand writes its own log: ~/.local/state/voice-foreman/foremand.log
StandardOutput=null

[Install]
WantedBy=graphical-session.target
